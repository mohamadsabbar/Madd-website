APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MikroTik RouterOS API (يجب تفعيل extension=sockets في PHP)
MIKROTIK_DEFAULT_PPP_PROFILE=default
MIKROTIK_API_TIMEOUT=10
MIKROTIK_API_SOCKET_TIMEOUT=25
# باقة افتراضية عند استيراد مشتركين من المايكروتيك (اختياري — وإلا أول باقة نشطة)
# MIKROTIK_IMPORT_PLAN_ID=1
# MIKROTIK_IMPORT_DURATION_DAYS=365
# عندما لا يطابق profile الراوتر أي mikrotik_profile في الباقات (بدل أول باقة)
# MIKROTIK_IMPORT_UNMATCHED_PLAN_ID=
# قيم افتراضية عند إنشاء باقات تلقائياً من ملفات PPP على المايكروتيك
# MIKROTIK_AUTO_PLAN_PRICE=0
# MIKROTIK_AUTO_PLAN_DURATION_DAYS=30
# MIKROTIK_AUTO_PLAN_SPEED_FALLBACK=20
# احتفاظ بلقطات الاستهلاك (بالأيام)
# MIKROTIK_TRAFFIC_RETENTION_DAYS=90
# لقطة ثانية بعد ثوانٍ لحساب الاستهلاك فوراً (false على الراوترات البطيئة)
# MIKROTIK_TRAFFIC_DOUBLE_SAMPLE=true
# MIKROTIK_TRAFFIC_SAMPLE_GAP=2
# مزامنة تلقائية مع المايكروتيك (دقائق، 1–59). يتطلب cron: php artisan schedule:run كل دقيقة
# MIKROTIK_SYNC_INTERVAL_MINUTES=1
# إعادة تحميل الرئيسية / التحليلات / الراوترات كل N ثانية (0 = إيقاف)
# MIKROTIK_ADMIN_UI_REFRESH_SECONDS=45

# يوم الشهر لانتهاء دورة الاشتراك (افتراضي 5: الخامس من الشهر التالي)
# SUBSCRIPTION_CYCLE_END_DAY=5

# ——— الفوترة والـ SMS ———
# BILLING_DAY=5
# أيام التذكير قبل يوم الفوترة (مفصولة بفاصلة): 3 و 1 = يومي 2 و 4 من الشهر تقريباً
# BILLING_REMINDER_DAYS=3,1
# BILLING_REMINDER_TIME=09:00
# وقت قطع من لهم دين يوم الفوترة
# BILLING_SUSPEND_TIME=00:05
# BILLING_COMPANY_NAME=أوليفيا
# HTD — http://sms.htd.ps/API/SendSMS.aspx?id=…&sender=…&to=970…&msg=…
# BILLING_SMS_ENABLED=true
# BILLING_SMS_API_URL=http://sms.htd.ps/API/SendSMS.aspx
# BILLING_SMS_HTTP_METHOD=GET
# نفس قيمة id في الرابط (لا ترفع المفتاح إلى git)
# BILLING_SMS_API_KEY=
# اسم المرسل المعتمد عند HTD (مثال من الوثائق: Olivia)
# BILLING_SMS_SENDER=Olivia
# تحويل 059… → 97059… (تفادي H006 Invalid DESTINATION)
# BILLING_SMS_PHONE_FORMAT=ps970
# تأخير بين الرسائل عند الإرسال الجماعي من لوحة التحكم (ملّي ثانية)
# BILLING_SMS_BETWEEN_MS=150
# إذا لم تصل الرسائل مع GET، جرّب: BILLING_SMS_FORCE_POST=true
# BILLING_SMS_FORCE_POST=false
# BILLING_SMS_MAX_GET_URL_LENGTH=1800
# BILLING_SMS_AUTH_HEADER=
# BILLING_SMS_BODY_STYLE=json
# افتراضياً: id,sender,to,msg — غيّر فقط إذا غيّر المزوّد الحقول
# BILLING_SMS_BODY_TEMPLATE={"id":"@api_key","sender":"@sender","to":"@phone","msg":"@message"}

# تطبيق العملاء: كلمة المرور الافتراضية عند إنشاء حساب المشترك تلقائياً
# SUBSCRIBER_PORTAL_DEFAULT_PASSWORD=100200300

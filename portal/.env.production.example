APP_NAME="مدد للاتصالات"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://madd.ps

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=madd_portal
DB_USERNAME=madd
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.madd.ps
SESSION_SECURE_COOKIE=true

# Behind Cloudflare + host Nginx
TRUSTED_PROXIES=*

SANCTUM_STATEFUL_DOMAINS=madd.ps,www.madd.ps,panel.madd.ps

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@madd.ps"
MAIL_FROM_NAME="${APP_NAME}"

# MikroTik — set on server only; never commit secrets
MIKROTIK_DEFAULT_PPP_PROFILE=default
MIKROTIK_API_TIMEOUT=10
MIKROTIK_API_SOCKET_TIMEOUT=25

SUBSCRIBER_PORTAL_DEFAULT_PASSWORD=100200300

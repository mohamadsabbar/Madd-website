APP_NAME="مدد للاتصالات"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://my.madd.ps

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=madd_portal
DB_USERNAME=madd
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.madd.ps
SESSION_SECURE_COOKIE=true

# Behind Cloudflare + host Nginx
TRUSTED_PROXIES=*

# Portal + marketing (site CMS cookies) + optional panel alias
SANCTUM_STATEFUL_DOMAINS=my.madd.ps,madd.ps,www.madd.ps,panel.madd.ps

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@madd.ps"
MAIL_FROM_NAME="${APP_NAME}"

# MikroTik — set on server only; never commit secrets
MIKROTIK_DEFAULT_PPP_PROFILE=default
MIKROTIK_API_TIMEOUT=10
MIKROTIK_API_SOCKET_TIMEOUT=25

SUBSCRIBER_PORTAL_DEFAULT_PASSWORD=100200300

# FCM for customer app push (legacy server key)
# FCM_SERVER_KEY=

# Meta WhatsApp Cloud API (keep disabled until templates approved)
# WHATSAPP_ENABLED=false
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_REMINDER_BEFORE=
# WHATSAPP_TEMPLATE_REMINDER_BEFORE_3=
# WHATSAPP_TEMPLATE_REMINDER_BEFORE_1=madd_reminder_before_1
# WHATSAPP_TEMPLATE_SUSPEND=madd_suspend
# WHATSAPP_TEMPLATE_PAID=
# WHATSAPP_TEMPLATE_LANGUAGE=ar
# WHATSAPP_TEMPLATE_HEADER_TYPE=none
# WHATSAPP_TEMPLATE_HEADER_IMAGE_URL=
# WHATSAPP_TEMPLATE_HEADER_TEXT=
# WHATSAPP_CTA_EXTEND_STAGES=before_1,suspend
# WHATSAPP_CTA_URL_DYNAMIC=false
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_CHAT_SESSION_TTL_HOURS=6
# WHATSAPP_EXTEND_TOKEN_TTL_HOURS=72
# WHATSAPP_BEFORE_DAYS=3,1
# WHATSAPP_REMINDER_TIME=10:30
# CHATWOOT_BASE_URL=https://chat.madd.ps
# CHATWOOT_ACCOUNT_ID=1
# CHATWOOT_BOT_ACCESS_TOKEN=
# CHATWOOT_BOT_WEBHOOK_TOKEN=


